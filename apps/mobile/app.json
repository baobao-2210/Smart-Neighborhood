{
  "expo": {
    "name": "Quản Lý Tổ Dân Phố",
    "slug": "quan-ly-to-dan-pho",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "todanpho",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.todanpho.app"
    },
    "android": {
      "package": "com.todanpho.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D47A1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để đính kèm hình ảnh vào bảng tin cộng đồng."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

