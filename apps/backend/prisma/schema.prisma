datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS HỆ THỐNG (6 MODULE - KHÔNG CÓ TÀI CHÍNH)
// ==========================================

enum UserRole {
  SUPER_ADMIN
  LEADER
  STAFF
  RESIDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETION_REQUESTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ResidenceType {
  THUONG_TRU
  TAM_TRU
  TAM_VANG
  LUU_TRU
}

enum ResidenceStatus {
  DANG_CU_TRU
  TAM_VANG
  DA_CHUYEN_DI
}

enum HouseholdRelation {
  CHU_HO
  VO_CHONG
  CON
  BO_ME
  ONG_BA
  CHAU
  ANH_CHI_EM
  NGUOI_THUE
  KHAC
}

enum DirectMessagePolicy {
  EVERYONE
  NEIGHBORHOOD_ONLY
  OFFICERS_ONLY
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostCategory {
  LIFE
  WARNING
  EVENT_RECAP
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  OFFICERS_ONLY
}

enum ReactionType {
  LIKE
  HEART
  CLAP
}

enum ReportCategory {
  INFRASTRUCTURE
  SANITATION
  SECURITY
  LIGHTING
  OTHER
}

enum ReportVisibility {
  PUBLIC
  PRIVATE
}

enum ReportStatus {
  NEW
  PENDING
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum PostType {
  NORMAL
  INCIDENT
}

enum ReportPriority {
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
}

enum PlaceCategory {
  NHA_VAN_HOA
  TRAM_Y_TE
  DIEM_CUU_HOA
  DIEM_SINH_HOAT
  OTHER
}

enum ConversationType {
  DIRECT
  GROUP
  SUPPORT
}

enum ConversationMemberRole {
  ADMIN
  MEMBER
}

enum MessageReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum AttachmentEntityType {
  POST
  REPORT
  ANNOUNCEMENT
  MESSAGE
}

// ==========================================
// 2. ĐA TỔ DÂN PHỐ (MULTI-TENANT ROOT)
// ==========================================

model Neighborhood {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  ward            String
  district        String
  city            String
  boundaryGeoJson Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users         User[]
  households    Household[]
  posts         Post[]
  reports       Report[]
  announcements Announcement[]
  events        Event[]
  places        CommunityPlace[]
  conversations Conversation[]
  auditLogs     AuditLog[]

  @@map("neighborhoods")
}

// ==========================================
// 3. TÀI KHOẢN, CÀI ĐẶT & BẢO MẬT (MODULE 6)
// ==========================================

model User {
  id               String     @id @default(uuid())
  neighborhoodId   String
  neighborhood     Neighborhood @relation(fields: [neighborhoodId], references: [id])
  phoneNumber      String     @unique
  email            String?    @unique
  passwordHash     String
  fullName         String
  avatarUrl        String?
  role             UserRole   @default(RESIDENT)
  staffTitle       String?
  status           UserStatus @default(ACTIVE)
  refreshTokenHash String?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  setting          UserSetting?
  deletionRequests AccountDeletionRequest[]
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  householdMember  HouseholdMember?

  posts            Post[]
  postEdits        PostEditHistory[]
  postContentReports PostReport[]
  comments         Comment[]
  reactions        Reaction[]
  submittedReports Report[]           @relation("ReportCreator")
  assignedReports  Report[]           @relation("ReportAssignee")
  reportChanges    ReportStatusHistory[]

  announcements    Announcement[]
  readReceipts     AnnouncementReadReceipt[]
  organizedEvents  Event[]
  eventRegistrations EventRegistration[]

  createdConversations Conversation[]
  conversationMembers  ConversationMember[]
  sentMessages         Message[]
  messageReports       MessageReport[]  @relation("MessageReporter")
  reviewedMsgReports   MessageReport[]  @relation("MessageReviewer")

  attachments      Attachment[]
  auditLogs        AuditLog[]

  @@index([neighborhoodId, role])
  @@map("users")
}

model UserSetting {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushAnnouncements  Boolean             @default(true)
  pushEvents         Boolean             @default(true)
  pushReports        Boolean             @default(true)
  pushMessages       Boolean             @default(true)
  allowDirectMessage DirectMessagePolicy @default(NEIGHBORHOOD_ONLY)
  showPhoneNumber    Boolean             @default(false)
  updatedAt          DateTime            @updatedAt

  @@map("user_settings")
}

model AccountDeletionRequest {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  status     DeletionRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId, status])
  @@map("account_deletion_requests")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id             String        @id @default(uuid())
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  action         String
  resource       String
  resourceId     String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([neighborhoodId, createdAt(sort: Desc)])
  @@index([actorId, action])
  @@map("audit_logs")
}

// ==========================================
// 4. QUẢN LÝ CƯ DÂN & HỘ GIA ĐÌNH (MODULE 3)
// ==========================================

model Household {
  id             String       @id @default(uuid())
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  code           String
  houseNumber    String
  street         String
  addressDetail  String?
  latitude       Float?
  longitude      Float?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        HouseholdMember[]

  @@unique([neighborhoodId, code])
  @@index([neighborhoodId])
  @@map("households")
}

model HouseholdMember {
  id              String            @id @default(uuid())
  householdId     String
  household       Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId          String?           @unique
  user            User?             @relation(fields: [userId], references: [id])
  fullName        String
  cccdNumber      String?           @unique
  dateOfBirth     DateTime
  gender          Gender
  isHead          Boolean           @default(false)
  relationToHead  HouseholdRelation @default(CON)
  residenceType   ResidenceType     @default(THUONG_TRU)
  residenceStatus ResidenceStatus   @default(DANG_CU_TRU)
  expiredAt       DateTime?
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([householdId, isHead])
  @@index([householdId, residenceStatus])
  @@map("household_members")
}

// ==========================================
// 5. BẢNG TIN CỘNG ĐỒNG & PHẢN ÁNH (MODULE 1 & 4)
// ==========================================

model Post {
  id             String         @id @default(uuid())
  neighborhoodId String
  neighborhood   Neighborhood   @relation(fields: [neighborhoodId], references: [id])
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  type           PostType       @default(NORMAL)
  category       PostCategory   @default(LIFE)
  visibility     PostVisibility @default(PUBLIC)
  title          String?
  content        String
  isPinned       Boolean        @default(false)
  isOfficial     Boolean        @default(false)
  locationName   String?
  latitude       Float?
  longitude      Float?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  comments       Comment[]
  reactions      Reaction[]
  incidentReport Report?
  editHistories  PostEditHistory[]
  contentReports PostReport[]

  @@index([neighborhoodId, isPinned(sort: Desc), createdAt(sort: Desc)])
  @@map("posts")
}

model PostEditHistory {
  id         String   @id @default(uuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  editorId   String
  editor     User     @relation(fields: [editorId], references: [id])
  oldTitle   String?
  oldContent String
  newTitle   String?
  newContent String
  createdAt  DateTime @default(now())

  @@index([postId, createdAt(sort: Desc)])
  @@map("post_edit_histories")
}

model PostReport {
  id         String   @id @default(uuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@unique([postId, reporterId])
  @@map("post_reports")
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId, createdAt])
  @@map("comments")
}

model Reaction {
  id        String       @id @default(uuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
  @@map("reactions")
}

model Report {
  id             String           @id @default(uuid())
  code           String?          @unique
  postId         String?          @unique
  post           Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  neighborhoodId String
  neighborhood   Neighborhood     @relation(fields: [neighborhoodId], references: [id])
  reporterId     String
  reporter       User             @relation("ReportCreator", fields: [reporterId], references: [id])
  assignedToId   String?
  assignedTo     User?            @relation("ReportAssignee", fields: [assignedToId], references: [id])
  category       ReportCategory   @default(OTHER)
  priority       ReportPriority   @default(NORMAL)
  visibility     ReportVisibility @default(PUBLIC)
  title          String
  description    String
  status         ReportStatus     @default(NEW)
  latitude       Float?
  longitude      Float?
  addressText    String?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  statusHistory  ReportStatusHistory[]

  @@index([neighborhoodId, visibility, status, createdAt(sort: Desc)])
  @@map("reports")
}

model ReportStatusHistory {
  id          String       @id @default(uuid())
  reportId    String
  report      Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id])
  fromStatus  ReportStatus
  toStatus    ReportStatus
  note        String?
  createdAt   DateTime     @default(now())

  @@index([reportId, createdAt])
  @@map("report_status_histories")
}

// ==========================================
// 6. THÔNG BÁO, SỰ KIỆN & BẢN ĐỒ (MODULE 2 & 4)
// ==========================================

model Announcement {
  id             String               @id @default(uuid())
  neighborhoodId String
  neighborhood   Neighborhood         @relation(fields: [neighborhoodId], references: [id])
  authorId       String
  author         User                 @relation(fields: [authorId], references: [id])
  title          String
  content        String
  priority       AnnouncementPriority @default(NORMAL)
  isPinned       Boolean              @default(false)
  publishedAt    DateTime             @default(now())
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  readReceipts   AnnouncementReadReceipt[]

  @@index([neighborhoodId, isPinned(sort: Desc), publishedAt(sort: Desc)])
  @@map("announcements")
}

model AnnouncementReadReceipt {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_read_receipts")
}

model Event {
  id             String       @id @default(uuid())
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  organizerId    String
  organizer      User         @relation(fields: [organizerId], references: [id])
  title          String
  description    String
  locationName   String
  latitude       Float?
  longitude      Float?
  startTime      DateTime
  endTime        DateTime?
  maxAttendees   Int?
  status         EventStatus  @default(UPCOMING)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  registrations  EventRegistration[]

  @@index([neighborhoodId, startTime])
  @@map("events")
}

model EventRegistration {
  id           String                  @id @default(uuid())
  eventId      String
  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User                    @relation(fields: [userId], references: [id])
  status       EventRegistrationStatus @default(REGISTERED)
  registeredAt DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model CommunityPlace {
  id             String        @id @default(uuid())
  neighborhoodId String
  neighborhood   Neighborhood  @relation(fields: [neighborhoodId], references: [id])
  name           String
  category       PlaceCategory @default(DIEM_SINH_HOAT)
  address        String
  latitude       Float
  longitude      Float
  details        Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([neighborhoodId, category])
  @@map("community_places")
}

// ==========================================
// 7. KẾT NỐI CỘNG ĐỒNG & TỆP ĐÍNH KÈM (MODULE 5)
// ==========================================

model Conversation {
  id             String           @id @default(uuid())
  neighborhoodId String
  neighborhood   Neighborhood     @relation(fields: [neighborhoodId], references: [id])
  type           ConversationType @default(DIRECT)
  name           String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  lastMessageAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  members        ConversationMember[]
  messages       Message[]

  @@index([neighborhoodId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMember {
  id             String                 @id @default(uuid())
  conversationId String
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id])
  memberRole     ConversationMemberRole @default(MEMBER)
  lastReadAt     DateTime?
  isMuted        Boolean                @default(false)
  joinedAt       DateTime               @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User            @relation(fields: [senderId], references: [id])
  content        String
  isModerated    Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  reports        MessageReport[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model MessageReport {
  id           String              @id @default(uuid())
  messageId    String
  message      Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User                @relation("MessageReporter", fields: [reporterId], references: [id])
  reason       String
  status       MessageReportStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?               @relation("MessageReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([status, createdAt])
  @@map("message_reports")
}

model Attachment {
  id         String               @id @default(uuid())
  uploaderId String
  uploader   User                 @relation(fields: [uploaderId], references: [id])
  entityType AttachmentEntityType
  entityId   String
  url        String
  mimeType   String
  fileSize   Int
  fileName   String?
  createdAt  DateTime             @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}
